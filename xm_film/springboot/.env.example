# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。
# JWT_SIGNING_KEY 至少 32 字节：用 PowerShell `-join ((48..57)+(97..102) | Get-Random -Count 96 | % {[char]$_})`（96 个十六进制字符），或 `openssl rand -hex 48`。
JWT_SIGNING_KEY=

DB_USERNAME=root
DB_PASSWORD=

# TMDB v4 read token（仅后台「从 TMDB 导入」使用）
TMDB_TOKEN=

# 高德开放平台 Web 服务 Key（仅后台「从高德导入影院名录」使用）
AMAP_KEY=

# Redis（可选；不填走 localhost:6379，服务不可用时业务自动降级）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 订单事件投递方式：local（默认，进程内直派，不需要 MQ）/ rabbit（真实 RabbitMQ）
ORDER_EVENT_PUBLISHER=local
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# 需要看 MyBatis SQL 时取消注释（默认 INFO；DEBUG 会打印绑定参数，含口令哈希）
# logging.level.com.example.springboot.mapper=DEBUG
