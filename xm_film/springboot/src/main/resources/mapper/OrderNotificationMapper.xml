<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.OrderNotificationMapper">

    <resultMap id="orderNotificationMap" type="com.example.springboot.entity.OrderNotification">
        <id column="id" property="id"/>
        <result column="event_id" property="eventId"/>
        <result column="event_type" property="eventType"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 依赖 uk_notification_event(event_id)：重复事件不会产生重复通知 -->
    <insert id="insertIgnore" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO order_notification (event_id, event_type, order_no, user_id, content)
        VALUES (#{eventId}, #{eventType}, #{orderNo}, #{userId}, #{content})
    </insert>

    <select id="countByOrderNo" resultType="int">
        SELECT COUNT(*) FROM order_notification WHERE order_no = #{orderNo}
    </select>

</mapper>
